{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "cloudflare/worker.mjs",
  "name": "khadafi",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat",
    "cache_option_enabled",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://mykgtajanxczdnzekycl.supabase.co",
    "DOKU_SITE_ORIGIN": "https://khadafidaffa.com",
    "DOKU_IS_PRODUCTION": "true",
    "DOKU_PRODUCTION_APPROVED": "true",
    "DOKU_ENABLED": "true",
    "PAYMENTS_ENABLED": "true",
    "DOKU_PUBLIC_SALES_APPROVED": "true",
    "DOKU_QRIS_ENABLED": "true",
    "DOKU_QRIS_STATUS": "ACTIVE",
    "DOKU_RECONCILE_ENABLED": "true",
    "COMMERCE_GUEST_CHECKOUT_ENABLED": "false",
    "TRANSACTION_EMAIL_ENABLED": "true",
    "TRANSACTION_EMAIL_PROVIDER": "smtp",
    "RESEND_REPLY_TO_VERIFIED": "true"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "khadafi"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "khadafi-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
