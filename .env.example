NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Optional legacy fallback until Supabase retires anon keys:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key-here
BLOG_ADMIN_EMAIL=admin@example.com
# Server-only (never use NEXT_PUBLIC_ prefix):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Runtime Secret for signing view tokens (Phase 1G.1):
ENGAGEMENT_SIGNING_SECRET=your-random-signing-secret-here

# Blog Studio AI Features (optional, default: false for production v1):
NEXT_PUBLIC_BLOG_AI_ENABLED=false

# Optional dedicated server credential; otherwise ENGAGEMENT_SIGNING_SECRET is used.
FREELANCE_SIGNUP_SECRET=

# Affiliate tracker: separate credentials and data scope for preview/production.
# Register the SHA-256 hash in private.affiliate_tracking_config; never commit values.
AFFILIATE_TRACKING_SECRET=
AFFILIATE_ENVIRONMENT=preview
# Additional approved domains also require a row in private.affiliate_allowed_hosts.
AFFILIATE_ALLOWED_HOSTS=

# Midtrans Snap: server-only credentials. Local development uses Sandbox.
# Production also requires activated merchant channels and the verified webhook URL.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ENABLED=false

# DOKU Checkout (server-side only). Configure on staging BEFORE enabling.
# Sandbox must point to a HTTPS staging site, not the public production domain.
DOKU_ENABLED=false
DOKU_IS_PRODUCTION=false
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_SITE_ORIGIN=https://staging.example.com
# Extra explicit production gate, only after merchant/channel & settlement approval:
DOKU_PRODUCTION_APPROVED=false
PAYMENTS_ENABLED=false
DOKU_PUBLIC_SALES_APPROVED=false
DOKU_QRIS_ENABLED=false
DOKU_QRIS_STATUS=UPDATING
# Explicit allowlisted isolated database; never use Khadafi/Chikki production here.
DOKU_SANDBOX_SUPABASE_URL=
DOKU_RECONCILE_ENABLED=false
DOKU_RECONCILE_TOKEN=
DOKU_QA_ENABLED=false
DOKU_QA_LIVE_APPROVED=false
DOKU_QA_FREE_ENABLED=false
DOKU_QA_USER_IDS=
DOKU_QA_PRODUCT_ID=
# Guest checkout stays closed until email recovery/delivery is independently verified.
COMMERCE_GUEST_CHECKOUT_ENABLED=false

# Public GA4 ID: evaluated during next build. Optional analytics consent is required.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-P6D1E895XB
# Set true only after reviewing automatic/history events in GA4.
NEXT_PUBLIC_GA_MANUAL_EVENTS_READY=false
